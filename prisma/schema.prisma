generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RcsApiProvider {
  msg91
  google
}

model User {
  id                  String              @id @default(uuid())
  full_name           String
  email               String              @unique
  phone_number        String
  password            String
  role                String              @default("user")
  is_verified         Boolean             @default(false)
  created_at          DateTime            @default(now())
  bio                 String?
  company_name        String?
  notification_pref   Json?               @default("{\"low_credit\": true, \"weekly_reports\": false, \"campaign_alerts\": true}")
  two_fact_enabled    Boolean             @default(false)
  two_fact_secret     String?
  recovery_codes      String[]            @default([])
  credit_plan_id      String?
  credit_balance      Float               @default(0)
  msg91_project_id    String?
  rcs_api             RcsApiProvider      @default(msg91)
  activities          Activity[]
  campaigns           Campaign[]
  contact_groups      ContactGroup[]
  contacts            Contact[]
  credit_requests     CreditRequest[]
  onboarding_requests OnboardingRequest[]
  refresh_tokens      RefreshToken[]
  template_drafts     TemplateDraft[]
  rcs_templates       RcsTemplate[]
  invoices            Invoice[]
  short_urls          ShortUrl[]
  credit_plan         CreditPlan?         @relation(fields: [credit_plan_id], references: [id])

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OnboardingRequest {
  id         String   @id @default(uuid())
  user_id    String
  status     String   @default("PENDING")
  message    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])

  @@map("onboarding_requests")
}

model CreditRequest {
  id                  String              @id @default(uuid())
  user_id             String
  credits             Int
  amount              Float
  status              CreditRequestStatus @default(PENDING)
  razorpay_order_id   String?
  razorpay_payment_id String?
  paid_at             DateTime?
  approved_at         DateTime?
  created_at          DateTime            @default(now())
  user                User                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("credit_requests")
}

model ContactGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  user_id     String
  created_at  DateTime @default(now())
  contacts    Contact[] @relation("ContactToGroup")
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([name, user_id])
  @@map("contact_groups")
}

model Contact {
  id           String   @id @default(uuid())
  name         String
  phone_number String
  status       String   @default("ACTIVE")
  user_id      String
  created_at   DateTime @default(now())
  groups       ContactGroup[] @relation("ContactToGroup")
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([phone_number, user_id])
  @@map("contacts")
}

model CreditPlan {
  id                String   @id @default(uuid())
  name              String   @unique
  rate_per_message  Float    @default(0.30)
  min_credits       Int      @default(10000)
  created_at        DateTime @default(now())
  ios_rate_extra    Float    @default(0.10)
  is_active         Boolean  @default(true)
  use_ios_surcharge Boolean  @default(false)
  users             User[]

  @@map("credit_plans")
}

model TemplateDraft {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  category   String?
  payload    Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("template_drafts")
}

model RcsTemplate {
  id         String   @id @default(uuid())
  user_id    String
  provider   String   @default("google")
  name       String
  category   String
  payload    Json
  status     String   @default("APPROVED")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("rcs_templates")
}

model Campaign {
  id               String          @id @default(uuid())
  user_id          String
  name             String
  template_name    String
  type             String
  status           String          @default("LIVE")
  contact_source   String?
  scheduled_at     DateTime?
  total_contacts   Int             @default(0)
  sent_count       Int             @default(0)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  msg91_request_id String?
  namespace        String?
  events           CampaignEvent[]
  user             User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("campaigns")
}

model CampaignEvent {
  id                String    @id @default(uuid())
  campaign_id       String
  phone_number      String
  event_type        String
  created_at        DateTime  @default(now())
  error_details     String?
  status_updated_at DateTime?
  delivered_at      DateTime?
  engagement        String?
  read_at           DateTime?
  sent_at           DateTime?
  user_response     String?
  country           String?
  country_code      String?
  telecom_circle    String?
  campaign          Campaign  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, phone_number])
  @@index([campaign_id])
  @@index([event_type])
  @@index([created_at])
  @@map("campaign_events")
}

model Activity {
  id          String   @id @default(uuid())
  user_id     String
  type        String
  title       String
  description String?
  metadata    Json?
  color       String?
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([type])
  @@index([created_at])
  @@map("activities")
}

model Invoice {
  id                  String   @id @default(uuid())
  user_id             String
  amount              Float
  status              String   @default("UNPAID")
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_link_id    String?
  razorpay_link_url   String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@map("invoices")
}

model ShortUrl {
  id           String   @id @default(uuid())
  original_url String   @unique
  short_code   String   @unique
  user_id      String?
  clicks       Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([short_code])
  @@map("short_urls")
}

model ProviderConfig {
  id                String   @id @default(uuid())
  provider          String   @unique
  allowed_templates String[]
  updated_at        DateTime @updatedAt

  @@map("provider_configs")
}


enum CreditRequestStatus {
  PENDING
  PAID
  APPROVED
  REJECTED
}
